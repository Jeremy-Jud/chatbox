{
  "name": "whatsup",
  "version": "1.9.0",
  "description": "WhatsUp: kleine Desktop-Chat-App. Freunde per Code hinzufügen und direkt chatten.",
  "author": "Jeremy-Jud",
  "homepage": "https://github.com/Jeremy-Jud/whatsup",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeremy-Jud/whatsup.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "build:web": "node scripts/build-web.js"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.whatsup.app",
    "productName": "WhatsUp",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/peerjs/dist/peerjs.min.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "WhatsUp-Setup.exe",
      "shortcutName": "WhatsUp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "WhatsUp.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "Jeremy-Jud",
      "repo": "whatsup"
    }
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  },
  "allowScripts": {
    "electron@45.2.3": true
  }
}
